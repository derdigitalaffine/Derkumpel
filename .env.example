NODE_ENV=production
REDMINE_BASE_URL=https://redmine.vgo-o.de
PUBLIC_BASE_URL=https://derkumpel.example.org
BIND_ADDRESS=127.0.0.1
APP_PORT=8080
# 32 random bytes, base64 encoded. Example generation: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME
SESSION_MAX_AGE_DAYS=30
REDMINE_TIMEOUT_MS=15000
MAX_UPLOAD_MB=25
# basemap.de Web Raster is the default; previous MAP_STYLE_URL settings are ignored.
# Tiles: https://sgx.geodatenzentrum.de/wmts_basemapde/tile/...
MAP_DEFAULT_CENTER=7.7546,49.4944
# Optional preferred municipality/admin bbox: west,south,east,north. Empty => radius fallback.
MAP_OFFLINE_BOUNDS=
MAP_OFFLINE_RADIUS_KM=12
# Clients must not poll more frequently than 120 seconds; smaller values are clamped.
POLL_INTERVAL_MS=120000
APP_HOST=derkumpel.example.org

# Optional Push source: plugin (Redmine-side event bridge) or polling (no plugin).
# Polling requires a dedicated administrator API key for Redmine impersonation/permissions.
# This key MUST remain server-side in .env (0600), never in the PWA or Git.
PUSH_MODE=plugin
PUSH_POLL_API_KEY=
PUSH_POLL_INTERVAL_SECONDS=90
PUSH_POLL_STATE_FILE=/app/push-data/polling-state.json
# Optional push adapter: subscriber database stored only on server.
# Generate keys once: npx web-push generate-vapid-keys --json
PUSH_ENABLED=false
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:administrator@example.org
# At least 32 unpredictable characters, shared only with the Redmine event hook.
PUSH_EVENT_TOKEN=
PUSH_STORE_FILE=/app/push-data/subscriptions.json

# Legacy native rapport configuration (optional; automatic storage is the default)
RAPPORT_ENABLED=false
RAPPORT_PROJECT_ID=
RAPPORT_TRACKER_ID=
RAPPORT_DATA_FIELD_ID=
RAPPORT_CATALOG_PROJECT_ID=
RAPPORT_MACHINE_TRACKER_ID=
RAPPORT_MATERIAL_TRACKER_ID=
RAPPORT_STATUS_DRAFT=
RAPPORT_STATUS_SUBMITTED=
RAPPORT_STATUS_REVIEW=
RAPPORT_STATUS_RETURNED=
RAPPORT_STATUS_CLOSED=
RAPPORT_DIRECTORY_KEY=
RAPPORT_SERVICE_KEY=

# Optional indexed custom fields for native Redmine queries (integer/date, see docs)
RAPPORT_SUMMARY_OWNER_FIELD_ID=
RAPPORT_SUMMARY_DATE_FIELD_ID=
RAPPORT_SUMMARY_WORK_FIELD_ID=
RAPPORT_SUMMARY_TARGET_FIELD_ID=
RAPPORT_SUMMARY_PAUSE_FIELD_ID=
RAPPORT_SUMMARY_DIFFERENCE_FIELD_ID=
RAPPORT_SUMMARY_MACHINES_FIELD_ID=
RAPPORT_SUMMARY_COUNT_FIELD_ID=

# Read-only recurring tasks: automatically detect tracker Grünpflegearbeiten and ticket field Ort.
# Optional explicit IDs override discovery.
GREEN_TRACKER_ID=
GREEN_MUNICIPALITY_FIELD_ID=

# Optional: locked, separate native issue holding the original final PDF and SHA-256
RAPPORT_ARCHIVE_TRACKER_ID=

# Optional: separate correction reports with own native workflow
RAPPORT_CORRECTION_TRACKER_ID=

# Automatic storage (default unless an existing native setup is configured)
# Existing project identifier, not display name. No custom fields/trackers required.
DERKUMPEL_PROJECT_IDENTIFIER=derkumpel
# Optional if PUSH_POLL_API_KEY or RAPPORT_DIRECTORY_KEY is already configured.
DERKUMPEL_ADMIN_API_KEY=
# RAPPORT_STORAGE_MODE=automatic # or native / disabled
