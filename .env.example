NODE_ENV=production
REDMINE_BASE_URL=https://redmine.vgo-o.de
PUBLIC_BASE_URL=https://derkumpel.example.org
BIND_ADDRESS=127.0.0.1
APP_PORT=8080
# 32 random bytes, base64 encoded. Example generation: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME
SESSION_MAX_AGE_DAYS=30
REDMINE_TIMEOUT_MS=15000
MAX_UPLOAD_MB=25
# basemap.de Web Raster is the default; previous MAP_STYLE_URL settings are ignored.
# Tiles: https://sgx.geodatenzentrum.de/wmts_basemapde/tile/...
MAP_DEFAULT_CENTER=7.7546,49.4944
# Optional preferred municipality/admin bbox: west,south,east,north. Empty => radius fallback.
MAP_OFFLINE_BOUNDS=
MAP_OFFLINE_RADIUS_KM=12
# Clients must not poll more frequently than 120 seconds; smaller values are clamped.
POLL_INTERVAL_MS=120000

# Optional real Web Push even when the PWA is closed. Opt-in; requires HTTPS and stable secrets.
# Configure with: ./setup.sh push-enable --contact mailto:administrator@example.org
# Only subscription metadata, per-user Redmine snapshots, and encrypted credentials live in SQLite.
PUSH_ENABLED=false
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_ENCRYPTION_SECRET=
PUSH_CONTACT=
PUSH_DB_PATH=/data/push.sqlite
PUSH_POLL_INTERVAL_MS=120000
APP_HOST=derkumpel.example.org
